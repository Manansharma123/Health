# Docker ignore file for sentiment recommendation system
# Prevents unnecessary files from being copied into Docker image

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
*.log

# Data (optional - uncomment if you don't want to include data in image)
# data/raw/*
# data/processed/*

# Git
.git/
.gitignore

# Docker
.dockerignore
Dockerfile
docker-compose.yml

# Documentation (optional)
*.md
!README.md
